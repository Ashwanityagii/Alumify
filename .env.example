# --- Supabase (leave blank to run in local in-memory demo mode) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, NEVER expose to the browser
# --- App ---
PORT=3001
APP_SECRET=change-me-to-a-long-random-string      # signs demo-mode tokens
NODE_ENV=development
ADMIN_SIGNUP_CODE=choose-a-long-secret-code        # needed to create an admin account from the Admin tab -> "Create admin account"
